# Stawi frontend environment variables
# Copy to .env for local development. Vite exposes only VITE_* to the browser.

# mock: in-memory demo data (src/lib/mock.ts). live: call the backend.
VITE_API_MODE=mock
# No trailing slash. Used only when VITE_API_MODE=live.
# Local backend default: http://localhost:4100
VITE_API_BASE_URL=https://stawi-backend-9yw1.onrender.com

# Server-only. Co-op assistant (src/lib/coop-assistant.server.ts). Not sent to the browser.
LOVABLE_API_KEY=

# Public origin for canonical URLs, Open Graph, the sitemap, and llms.txt.
# Unset uses the request host. Set the production site before launch.
# VITE_SITE_URL=https://stawi.africa
