# ---------- General ----------
NODE_ENV=production
PORT=4000
# Comma-separated allowed browser origins. "*.domain" matches any subdomain. Add your deployed frontend origin.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,*.lovable.app,*.lovableproject.com
STAWI_FEE_RATE=0.008                # 0.8%, shown transparently in the UI
SEED=true                           # seed demo co-op + exporter on boot (PIN 1234). Set false for real data.

# ---------- Payaza ----------
PAYAZA_MODE=mock                    # mock | sandbox | live
PAYAZA_PUBLIC_KEY=
PAYAZA_SECRET_KEY=
PAYAZA_PIN=
PAYAZA_BASE_URL=                    # from Payaza engineers / docs.payaza.africa
PAYAZA_WEBHOOK_SECRET=

# ---------- Africa's Talking ----------
AT_ENV=sandbox                      # sandbox | live
AT_USERNAME=sandbox                 # your live app username when AT_ENV=live
AT_API_KEY=
AT_SENDER_ID=                       # live only, after approval
AT_CALLBACK_SECRET=change-me        # register callback as https://<api>/ussd/callback?s=<this>
