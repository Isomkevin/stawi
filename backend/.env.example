# Stawi Backend Environment Variables

PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# Payaza Configuration
# PAYAZA_MODE: mock | sandbox | live
PAYAZA_MODE=mock
PAYAZA_PUBLIC_KEY=PZ78-PKTEST-placeholder
PAYAZA_SECRET_KEY=PZ78-SKTEST-placeholder
PAYAZA_PIN=123456
PAYAZA_TENANT=test
# KES payazaAccountReference. Leave blank to resolve it from the main-accounts enquiry.
PAYAZA_KES_ACCOUNT_REF=
# Documented M-Pesa collection code. Confirm the payout bank code with Payaza if a transfer is rejected.
PAYAZA_MPESA_BANK_CODE=SAFKEN
# Required for bank (kepss) payouts. Do not invent a code.
PAYAZA_BANK_CODE=
# Set true only after Payaza enables signed transfers for this account.
PAYAZA_SIGN_TRANSFERS=false
PAYAZA_REDIRECT_URL=https://stawi.africa/paid

# Africa's Talking Configuration (USSD & SMS)
# AT_ENV: sandbox | live
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=at_sandbox_key_placeholder
AT_CALLBACK_SECRET=s3cret
AT_SENDER_ID=STAWI

# Postgres. Leave empty to use the in-memory store (local mock only).
DATABASE_URL=
# Sessions are required in production and when PAYAZA_MODE is sandbox or live.
# AUTH_REQUIRED=false
# Show the login code in POST /auth/otp (dev_code) outside production.
# Mock mode already does this. Set true to force it, false to hide it. Never returned in production.
OTP_DEV_CODES=true
# One code that signs in any existing phone, including production. Empty disables it.
# Anyone who knows it can open any account, so clear it before real users.
MASTER_LOGIN_CODE=123456

# Phone-mapping admin at /admin/phones. Unset hides the page.
ADMIN_SECRET=

# Demo ledger (4 co-ops, 76 farmers, 6 exporters, PIN 1234). See docs/SCAFFOLD.md.
# Loads on startup when this is true, or when NODE_ENV is not production and this is not false.
# Skipped if acc_treasurer already exists. Empty the database to reseed. Production should stay false.
# Seeding does not turn off live Payaza calls. Sample rows are marked is_demo.
SEED=true
# Default for the Demo Data switch when an account has not saved its own value.
# Unset or true: sample rows stay visible. false hides them until an account turns the switch on.
# An account override (PATCH /accounts/:id/settings) wins over this. It never changes PAYAZA_MODE.
# DEMO_DATA_ENABLED=true

# FX quotes for checkout and settlement. Frankfurter v2, no API key.
# off keeps the illustrative KES table (USD 129, EUR 142, GBP 168, KES 1).
# FX_FEED=frankfurter
# FX_FEED_URL=https://api.frankfurter.dev/v2/rates?base=USD&quotes=KES,EUR,GBP,NGN,GHS,UGX,TZS,ZAR,XOF,ZMW,LRD,CDF,XAF
# Cache lifetime in milliseconds. Default is 6 hours. A failed refresh keeps the last good cache.
# FX_CACHE_TTL_MS=21600000


USSD AT_CALLBACK_URL=https://stawi-backend-9yw1.onrender.com/ussd/callback?s=9f2c6e1a8b4d7035e6c1a9f0842d7b3c51e8a6d0f4b297c1
