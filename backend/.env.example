# Stawi Backend Environment Variables

PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# Payaza Configuration
# PAYAZA_MODE: mock | sandbox | live
PAYAZA_MODE=mock
PAYAZA_PUBLIC_KEY=PZ78-PKTEST-placeholder
PAYAZA_SECRET_KEY=PZ78-SKTEST-placeholder
PAYAZA_PIN=123456
PAYAZA_TENANT=test
# KES payazaAccountReference. Leave blank to resolve it from the main-accounts enquiry.
PAYAZA_KES_ACCOUNT_REF=
# Documented M-Pesa collection code. Confirm the payout bank code with Payaza if a transfer is rejected.
PAYAZA_MPESA_BANK_CODE=SAFKEN
# Required for bank (kepss) payouts. Do not invent a code.
PAYAZA_BANK_CODE=
# Set true only after Payaza enables signed transfers for this account.
PAYAZA_SIGN_TRANSFERS=false
PAYAZA_REDIRECT_URL=https://stawi.africa/paid

# Africa's Talking Configuration (USSD & SMS)
# AT_ENV: sandbox | live
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=at_sandbox_key_placeholder
AT_CALLBACK_SECRET=s3cret
AT_SENDER_ID=STAWI

# Postgres. Leave empty to use the in-memory store (local mock only).
DATABASE_URL=
# Sessions are required in production and when PAYAZA_MODE is sandbox or live.
# AUTH_REQUIRED=false

# Demo ledger (4 co-ops, 76 farmers, 6 exporters, PIN 1234). See docs/SCAFFOLD.md.
# Loads on startup when this is true, or when NODE_ENV is not production and this is not false.
# Skipped if acc_treasurer already exists. Empty the database to reseed. Production should stay false.
SEED=true


USSD AT_CALLBACK_URL=https://stawi-backend-9yw1.onrender.com/ussd/callback?s=9f2c6e1a8b4d7035e6c1a9f0842d7b3c51e8a6d0f4b297c1
