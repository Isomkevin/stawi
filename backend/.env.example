# Stawi Backend Environment Variables

PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# Payaza Configuration
# PAYAZA_MODE: mock | sandbox | live
PAYAZA_MODE=mock
PAYAZA_PUBLIC_KEY=PZ78-PKTEST-placeholder
PAYAZA_SECRET_KEY=PZ78-SKTEST-placeholder
PAYAZA_PIN=123456
PAYAZA_TENANT=test

# Africa's Talking Configuration (USSD & SMS)
# AT_ENV: sandbox | live
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=at_sandbox_key_placeholder
AT_CALLBACK_SECRET=s3cret
AT_SENDER_ID=STAWI

# Demo Seed Data
SEED=true
