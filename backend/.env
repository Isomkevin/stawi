PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# Payaza Configuration
PAYAZA_MODE=mock
PAYAZA_PUBLIC_KEY=PZ78-PKTEST-mock-key
PAYAZA_SECRET_KEY=PZ78-SKTEST-mock-secret
PAYAZA_PIN=123456
PAYAZA_TENANT=test

# Africa's Talking Configuration (USSD & SMS)
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=at_sandbox_key_mock
AT_CALLBACK_SECRET=s3cret
AT_SENDER_ID=STAWI

# Demo Seed Data
SEED=true

# One code that signs in any existing account. Empty disables it.
# Unset this before real users can sign in.
MASTER_LOGIN_CODE=123456
OTP_DEV_CODES=true
